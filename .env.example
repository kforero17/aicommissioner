# Yahoo OAuth Configuration
# Get these from https://developer.yahoo.com/apps/
YAHOO_CLIENT_ID=your_yahoo_client_id_here
YAHOO_CLIENT_SECRET=your_yahoo_client_secret_here
YAHOO_REDIRECT_URI=https://pike-charger-learners-schedule.trycloudflare.com/auth/yahoo/callback

# Security Keys
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_64_character_hex_string_here

# Generate ENCRYPTION_KEY with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate_a_fernet_key_here

# Application Configuration
FRONTEND_URL=https://pike-charger-learners-schedule.trycloudflare.com
DEBUG=false

# Database Configuration
DATABASE_URL=postgresql+asyncpg://username:password@localhost/aicommissioner

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379

# AI Services
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key
NEWS_API_KEY=your_newsapi_key
