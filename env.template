# Database Configuration
DATABASE_URL=postgresql+asyncpg://username:password@localhost/aicommissioner

# Redis Configuration (for Celery)
REDIS_URL=redis://localhost:6379

# Yahoo OAuth Configuration
# Get these from https://developer.yahoo.com/apps/
YAHOO_CLIENT_ID=your_yahoo_client_id_here
YAHOO_CLIENT_SECRET=your_yahoo_client_secret_here
YAHOO_REDIRECT_URI=http://localhost:8000/auth/yahoo/callback

# AI Service API Keys (optional)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Application Security (REQUIRED - generate with commands below)
# Generate SECRET_KEY: openssl rand -hex 32
SECRET_KEY=your_secret_key_here_change_in_production
# Generate ENCRYPTION_KEY: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_encryption_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# GroupMe Integration (optional)
GROUPME_ACCESS_TOKEN=your_groupme_token_here

# Email/SMTP Configuration (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com

# Application Settings
DEBUG=true
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000

# Timezone
DEFAULT_TIMEZONE=America/Chicago
